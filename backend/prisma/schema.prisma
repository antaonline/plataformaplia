generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Order {
  id                 Int                  @id @default(autoincrement())
  userId             Int?
  email              String?
  planId             Int
  amount             Decimal
  currency           String
  status             OrderStatus          @default(PENDING)
  transactionId      String?
  billingCycleMonths Int?
  metadata           String?              @db.LongText
  // Afiliado al que se atribuye esta orden (capturado en el checkout desde
  // la cookie plia_ref). affiliateCode guarda el código tal cual por si la
  // cuenta cambia. Null = venta sin afiliado.
  affiliateId        Int?
  affiliateCode      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  domainSelection    DomainSelection?
  subscriptions      HostingSubscription?
  plan               plan                 @relation(fields: [planId], references: [id], map: "Order_planId_fkey")
  user               user?                @relation(fields: [userId], references: [id], map: "Order_userId_fkey")
  payment            Payment?
  projects           Project?
  affiliate          AffiliateAccount?    @relation(fields: [affiliateId], references: [id])
  commission         AffiliateCommission?

  @@index([planId], map: "Order_planId_fkey")
  @@index([userId], map: "Order_userId_fkey")
  @@index([affiliateId])
  @@map("order")
}

model DomainSelection {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  domain    String
  price     Decimal
  currency  String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])

  @@map("domainselection")
}

model plan {
  id              Int                   @id @default(autoincrement())
  name            String
  description     String
  price           Float
  hostingYear     Boolean               @default(true)
  slug            String?               @unique
  serviceType     PlanServiceType       @default(WEBSITE_BUILD)
  createdAt       DateTime              @default(now())
  // Comisión fija en soles que se paga al afiliado por cada venta de este
  // plan. Editable desde el admin. 0 = el plan no genera comisión.
  affiliateCommission Float             @default(0)
  subscription    HostingSubscription[]
  order           Order[]
  studioLimits    StudioPlanLimits?
}

// Límites específicos para planes de Plia Studio (iachat AI).
// Relación 1:1 con `plan`. Los planes que NO son de Studio (LANDING/WEB
// tradicionales) simplemente no tienen este registro asociado y el
// código asume "sin acceso a Studio".
model StudioPlanLimits {
  id                   Int     @id @default(autoincrement())
  planId               Int     @unique
  plan                 plan    @relation(fields: [planId], references: [id])

  // ── Capacidad ──
  maxProjects          Int     @default(1)        // -1 = ilimitado
  maxGenerationsPerMonth Int   @default(10)       // -1 = ilimitado

  // ── Herramientas creativas habilitadas ──
  canUseClaude         Boolean @default(true)     // Claude para chat + código
  canUseDalle          Boolean @default(true)     // DALL-E para imágenes
  canUseFlux           Boolean @default(false)    // Flux Pro (calidad alta)
  canUseTripo3D        Boolean @default(false)    // Imagen → 3D
  canUseMeshy          Boolean @default(false)    // Alternativa a Tripo3D
  canUseHigsfield      Boolean @default(false)    // Video cinematográfico AI
  canUseRunway         Boolean @default(false)    // Video transitions
  canUseLumaAI         Boolean @default(false)    // Alternativa video
  canUseLottieLib      Boolean @default(true)     // Librería propia de Lotties

  // ── Features del editor ──
  canEditCode          Boolean @default(false)    // Acceso al código fuente
  canUseAdvancedCanvas Boolean @default(false)    // Canvas Konva con zoom/drag (vs editor simple)
  canUseInlineEditing  Boolean @default(true)     // Click en elemento → editar
  canUse3DTemplates    Boolean @default(false)    // Templates 3D cinematográficos
  canUseCustomDomain   Boolean @default(false)    // Vincular dominio propio
  hasWatermark         Boolean @default(true)     // "Made with PLIA" en footer

  // ── Soporte ──
  supportTier          String  @default("community") // community | email | priority

  // ── White label (solo Studio/Agency) ──
  whiteLabelEnabled    Boolean @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Project {
  id                    Int                  @id @default(autoincrement())
  name                  String
  completed             Boolean              @default(false)
  completedAt           DateTime?
  userId                Int
  orderId               Int                  @unique
  type                  ProjectType
  status                ProjectStatus        @default(WAITING_INFO)
  onboardingData        String?              @db.LongText
  onboardingStep        Int                  @default(1)
  startedAt             DateTime?
  deadline              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  hostingSubscriptionId Int?
  // ── Freemium / Trial (solo website_build: landing y web institucional) ──
  // isTrial: el proyecto se creó en modo prueba gratuita (sin pago).
  // trialEndsAt: fecha límite de la prueba (publicación + 30 días).
  // trialStatus: 'active' (en prueba) | 'suspended' (pausada día 30) | 'converted' (pagó).
  isTrial               Boolean              @default(false)
  trialEndsAt           DateTime?
  trialStatus           String?
  // isShowcase: el proyecto se exhibe públicamente en plia.pe/ejemplos.
  // showcaseSector: etiqueta de rubro para agrupar/filtrar en la galería.
  isShowcase            Boolean              @default(false)
  showcaseSector        String?
  // ── Dominio propio del cliente (vinculado vía LiteSpeed vhAlias) ──
  // Cuando el cliente conecta su dominio propio (ej. "mi-marca.com"), se
  // configura como vhAlias del vhost del subdominio plia.pe correspondiente
  // (sin crear un sitio nuevo en CyberPanel → 0 slot extra del package).
  // El subdominio queda como redirect 301 al dominio principal.
  customDomain          String?              @unique
  customDomainAttachedAt DateTime?
  subscription          HostingSubscription? @relation(fields: [hostingSubscriptionId], references: [id])
  order                 Order                @relation(fields: [orderId], references: [id])
  user                  user                 @relation(fields: [userId], references: [id])

  @@index([hostingSubscriptionId], map: "project_hostingSubscriptionId_fkey")
  @@index([userId], map: "project_userId_fkey")
  @@map("project")
}

model HostingSubscription {
  id                       Int              @id @default(autoincrement())
  projectId                Int?
  userId                   Int
  planId                   Int
  sourceOrderId            Int?             @unique
  serviceType              PlanServiceType  @default(WEBSITE_BUILD)
  billingCycleMonths       Int              @default(12)
  cycleAmount              Decimal?
  metadata                 String?          @db.LongText
  startDate                DateTime         @default(now())
  endDate                  DateTime
  status                   String
  nextBillingAt            DateTime
  lastChargedAt            DateTime?
  cardToken                String?
  renewalDueAt             DateTime?
  renewalNoticeSentAt      DateTime?
  renewalReminderSentAt    DateTime?
  renewalFinalNoticeSentAt DateTime?
  account                  HostingAccount?  @relation("ActiveSubscription")
  renewals                 HostingRenewal[]
  plan                     plan             @relation(fields: [planId], references: [id], map: "Subscription_planId_fkey")
  user                     user             @relation(fields: [userId], references: [id], map: "Subscription_userId_fkey")
  sourceOrder              Order?           @relation(fields: [sourceOrderId], references: [id])
  projects                 Project[]

  @@index([planId], map: "Subscription_planId_fkey")
  @@index([userId], map: "Subscription_userId_fkey")
  @@map("hostingsubscription")
}

model user {
  id                  Int                   @id @default(autoincrement())
  name                String
  email               String                @unique(map: "User_email_key")
  password            String
  createdAt           DateTime              @default(now())
  role                user_role             @default(USER)
  billingAddress      String?
  billingDepartment   String?
  billingEmail        String?
  billingName         String?
  aiChats             AiChat[]
  aiCredits           AiCredit?
  email2faCodes       Email2FACode[]
  hostingAccount      HostingAccount?
  subscription        HostingSubscription[]
  order               Order[]
  passwordSetupTokens PasswordSetupToken[]
  projects            Project[]
  refreshTokens       RefreshToken[]
  affiliateAccount    AffiliateAccount?
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  userId      Int
  fingerprint String
  userAgent   String?
  ip          String?
  revoked     Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refreshtoken_userId_fkey")
  @@map("refreshtoken")
}

model Email2FACode {
  id        String   @id @default(uuid())
  userId    Int
  code      String   @db.Char(6)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email2facode")
}

model Payment {
  id                Int       @id @default(autoincrement())
  orderId           Int       @unique
  amount            Float
  transactionId     String?   @unique
  authorizationCode String?
  status            String
  provider          String
  providerResponse  String?   @db.LongText
  createdAt         DateTime  @default(now())
  rawResponse       String    @db.LongText
  paidAt            DateTime?
  order             Order     @relation(fields: [orderId], references: [id])

  @@map("payment")
}

model PasswordSetupToken {
  id        String   @id @default(uuid())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("passwordsetuptoken")
}

model HostingRenewal {
  id               Int                 @id @default(autoincrement())
  subscriptionId   Int
  amount           Float
  currency         String              @default("PEN")
  status           RenewalStatus       @default(PENDING)
  transactionId    String?
  cardToken        String?
  provider         String?
  providerResponse String?             @db.LongText
  rawResponse      String?             @db.LongText
  createdAt        DateTime            @default(now())
  paidAt           DateTime?
  subscription     HostingSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("hostingrenewal")
}

model HostingAccount {
  id                   Int                  @id @default(autoincrement())
  userId               Int                  @unique
  activeSubscriptionId Int?                 @unique
  packageName          String
  status               HostingAccountStatus @default(PROVISIONING)
  maxSites             Int
  storageMb            Int
  bandwidthMb          Int
  mailboxesPerSite     Int
  cyberpanelUsername   String
  email                String
  panelUrl             String
  encryptedPassword    String?
  metadata             String?              @db.LongText
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  sites                HostedSite[]
  activeSubscription   HostingSubscription? @relation("ActiveSubscription", fields: [activeSubscriptionId], references: [id])
  user                 user                 @relation(fields: [userId], references: [id])

  @@map("hostingaccount")
}

model HostedSite {
  id               Int               @id @default(autoincrement())
  hostingAccountId Int
  name             String
  domain           String            @unique
  siteType         HostedSiteType
  appType          HostedSiteAppType @default(EMPTY)
  status           HostedSiteStatus  @default(PROVISIONING)
  sslStatus        HostingSslStatus  @default(PENDING)
  rootPath         String
  publicUrl        String
  storageUsedMb    Int               @default(0)
  uploadCount      Int               @default(0)
  lastUploadedAt   DateTime?
  lastDeployedAt   DateTime?
  metadata         String?           @db.LongText
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  mailboxes        HostedMailbox[]
  hostingAccount   HostingAccount    @relation(fields: [hostingAccountId], references: [id])

  @@index([hostingAccountId])
  @@map("hostedsite")
}

model HostedMailbox {
  id           Int        @id @default(autoincrement())
  hostedSiteId Int
  email        String     @unique
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  hostedSite   HostedSite @relation(fields: [hostedSiteId], references: [id])

  @@index([hostedSiteId])
  @@map("hostedmailbox")
}

model AiCredit {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  plan        String   @default("EXPLORADOR") // EXPLORADOR|PRESENCIA|EMPRENDEDOR|AGENCIA
  dailyUsed   Int      @default(0) // creditos * 100 (punto fijo) usados hoy
  monthlyUsed Int      @default(0) // creditos * 100 usados este mes
  lastResetAt DateTime @default(now())
  user        user     @relation(fields: [userId], references: [id])

  @@map("aicredit")
}

model AiChat {
  id          Int         @id @default(autoincrement())
  userId      Int
  title       String?
  previewUrl  String?
  status      String      @default("ACTIVE")
  metadata    String?     @db.LongText
  aiRules     String?     @db.LongText   // AI_RULES.md del proyecto (estética y contexto del cliente)
  themePrompt String?     @db.LongText   // Instrucciones visuales extraídas del primer prompt
  chatMode    String      @default("build") // 'build' | 'ask' | 'plan'
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        user        @relation(fields: [userId], references: [id])
  messages    AiMessage[]

  @@index([userId], map: "aichat_userId_fkey")
  @@map("aichat")
}

model AiMessage {
  id           Int      @id @default(autoincrement())
  chatId       Int
  role         String
  content      String   @db.LongText
  images       String?  @db.LongText // Array JSON de URLs o base64
  codeSnapshot String?  @db.LongText
  createdAt    DateTime @default(now())
  chat         AiChat   @relation(fields: [chatId], references: [id])

  @@index([chatId], map: "aimessage_chatId_fkey")
  @@map("aimessage")
}

// ─────────────────────────────────────────────────────────────────────────
//  PROGRAMA DE AFILIADOS
// ─────────────────────────────────────────────────────────────────────────

// Cuenta de afiliado de un usuario. Cualquier usuario logueado (freemium o de
// pago) puede tenerla. `code` es el identificador del link (plia.pe/?ref=code).
// El usuario puede guardar datos de Yape Y de banco, pero `payoutMethod` define
// cuál queda HABILITADO para cobrar (excluyente).
model AffiliateAccount {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  code          String   @unique
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED

  // Medio de cobro habilitado: "YAPE" | "BANK" | null (aún no elige)
  payoutMethod  String?
  yapeNumber    String?
  yapeName      String?
  bankName      String?
  bankAccount   String?
  bankCci       String?
  bankHolder    String?
  bankDocType   String?  // DNI | RUC | CE
  bankDocNumber String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           user                  @relation(fields: [userId], references: [id])
  referrals      AffiliateReferral[]
  commissions    AffiliateCommission[]
  payouts        AffiliatePayout[]
  referredOrders Order[]

  @@map("affiliateaccount")
}

// Registro de un click/visita atribuida (para estadísticas y dedupe por cookie).
model AffiliateReferral {
  id          Int      @id @default(autoincrement())
  affiliateId Int
  visitorId   String
  landingPath String?  @db.Text
  ipHash      String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([visitorId])
  @@map("affiliatereferral")
}

// Comisión generada por una venta. 1 por orden (orderId @unique → idempotente).
// status: AVAILABLE (disponible al instante) | PAID (incluida en un retiro
// pagado) | REVERSED (la orden se reembolsó/canceló). readAt = null → cuenta
// para la bolita de notificaciones del menú.
model AffiliateCommission {
  id          Int       @id @default(autoincrement())
  affiliateId Int
  orderId     Int       @unique
  payoutId    Int?
  amount      Decimal
  currency    String    @default("PEN")
  status      String    @default("AVAILABLE")
  readAt      DateTime?
  reversedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id])
  order       Order            @relation(fields: [orderId], references: [id])
  payout      AffiliatePayout? @relation(fields: [payoutId], references: [id])

  @@index([affiliateId])
  @@index([payoutId])
  @@map("affiliatecommission")
}

// Solicitud de retiro del afiliado. El admin paga por Yape/banco y marca PAID.
// dueBy = requestedAt + 3 días hábiles (SLA mostrado al afiliado).
model AffiliatePayout {
  id          Int       @id @default(autoincrement())
  affiliateId Int
  amount      Decimal
  currency    String    @default("PEN")
  method      String    // YAPE | BANK (snapshot al momento del retiro)
  destination String?   @db.Text // snapshot de los datos de cobro
  reference   String?   // nro de operación / constancia del pago
  status      String    @default("REQUESTED") // REQUESTED | PAID | REJECTED
  notes       String?   @db.Text
  requestedAt DateTime  @default(now())
  dueBy       DateTime?
  paidAt      DateTime?

  affiliate   AffiliateAccount      @relation(fields: [affiliateId], references: [id])
  commissions AffiliateCommission[]

  @@index([affiliateId])
  @@map("affiliatepayout")
}

enum PlanServiceType {
  WEBSITE_BUILD
  HOSTING_ONLY
  STUDIO_SUBSCRIPTION  // Plia Studio (iachat AI) — planes Free/Starter/Pro/Studio
}

enum ProjectType {
  LANDING
  WEB
}

enum ProjectStatus {
  WAITING_INFO
  IN_PROGRESS
  READY
  DELIVERED
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  APPROVED
  DECLINED
  FAILED
  CANCELLED
}

enum RenewalStatus {
  PENDING
  PAID
  FAILED
}

enum HostingAccountStatus {
  PROVISIONING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  ERROR
}

enum HostedSiteStatus {
  PROVISIONING
  ACTIVE
  PAST_DUE
  SUSPENDED
  ERROR
  DELETED
}

enum HostedSiteType {
  SUBDOMAIN
  CUSTOM_DOMAIN
}

enum HostedSiteAppType {
  EMPTY
  STATIC_UPLOAD
  WORDPRESS
}

enum HostingSslStatus {
  PENDING
  ACTIVE
  FAILED
  NOT_CONFIGURED
}

enum user_role {
  USER
  ADMIN
}
