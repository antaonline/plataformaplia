# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

ecosystem.config.js

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Experimental Features — DEPRECADO. El glob `experimental/` ignoraba
# tambien `components/experimental/*` que SI son codigo de produccion
# (ThinkingEngine, FileExplorer, UpsellModal). Solo dejamos un ignore
